# Prod stack (compose.yml in this folder). Copy to .env and fill in the required values.

# --- Required ---------------------------------------------------------------

# Postgres password for the `db` service.
POSTGRES_PASSWORD=password

# A hash of your sign-in password, never the password itself:
#   npm run hash-password   (or: docker run --rm -it sanjeevstunner/dossier hash-password)
DOSSIER_PASSWORD=

# Signs sessions and encrypts stored API keys; changing it signs you out.
#   openssl rand -base64 32
DOSSIER_SECRET=

# --- Noperi (required) ----------------------------------------------------

# Clients send this as `x-api-key` (or `Authorization: Bearer ...`). Min 16 chars.
#   openssl rand -hex 24
NOPERI_API_KEY=
# Naukri account (single user).
NAUKRI_USERNAME=
NAUKRI_PASSWORD=
# Optional outbound proxy, e.g. http://user:pass@host:port or socks5://host:port.
# Naukri flags most cloud/datacenter IPs; a residential proxy helps on a server.
# NAUKRI_PROXY=


# --- Ports (bound to 127.0.0.1; put a reverse proxy with HTTPS in front) ----
DOSSIER_PORT=3000
NOPERI_PORT=3001

# --- Optional ---------------------------------------------------------------

# Time zone for the nightly 03:00 backup, e.g. Asia/Kolkata.
# TZ=
# Days of nightly backups to keep (default 14).
# DOSSIER_BACKUP_RETENTION_DAYS=14
# Usage ping: unset asks after sign-in; on or off answers in advance.
# DOSSIER_TELEMETRY=

# AI provider defaults: local, openai, anthropic, mistral or lmstudio.
# Add COMPOSE_PROFILES=ai to run Ollama, reached at http://ollama:11434.
# COMPOSE_PROFILES=ai
# DOSSIER_AI_PROVIDER=local
# DOSSIER_AI_URL=http://ollama:11434
# DOSSIER_AI_MODEL=llama3.1:8b
# DOSSIER_AI_KEY=
# DOSSIER_AI_TIMEOUT_SECONDS=300

# Job search defaults: jsearch, adzuna, arbeitsagentur or off.
# DOSSIER_JOBS_SOURCE=jsearch
# DOSSIER_JSEARCH_KEY=
# DOSSIER_JSEARCH_HOST=openwebninja
# DOSSIER_ADZUNA_APP_ID=
# DOSSIER_ADZUNA_KEY=

# Gmail and Calendar: OAuth client with redirect <DOSSIER_PUBLIC_URL>/api/google/callback.
# DOSSIER_GOOGLE_CLIENT_ID=
# DOSSIER_GOOGLE_CLIENT_SECRET=
# The address Dossier is reached at, e.g. https://dossier.example.com.
# DOSSIER_PUBLIC_URL=
